{
  "name": "@tesyl/site-screean",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Website for @tesyl/screean and @tesyl/screean-components.",
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && npm run verify:docs",
    "test": "vitest run",
    "clean": "rm -rf .next .turbo node_modules *.tsbuildinfo",
    "verify:docs": "tsc -p docs-verify/tsconfig.json"
  },
  "dependencies": {
    "@tesyl/content": "workspace:*",
    "@tesyl/screean": "^0.3.0",
    "@tesyl/screean-components": "^0.3.0",
    "next": "^16.4.6",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
